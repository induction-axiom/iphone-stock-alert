{
  "manifest_version": 3,
  "name": "Duo Watch",
  "version": "1.0.0",
  "description": "Watches Apple Store pickup stock for iPhone Duo from your own browser and alarms when it's in stock.",
  "permissions": ["notifications", "storage", "alarms", "tabs"],
  "host_permissions": ["https://www.apple.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Duo Watch" },
  "content_scripts": [
    {
      "matches": ["https://www.apple.com/*shop/buy-iphone/iphone-duo*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
